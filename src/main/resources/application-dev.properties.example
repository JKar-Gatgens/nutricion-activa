# Plantilla del perfil "dev" para MySQL local. Copiar como
# application-dev.properties (mismo directorio) y reemplazar el placeholder
# por la contrasena real del usuario na_app en tu MySQL local. Ese archivo
# NO se commitea (ver .gitignore).
#
# Activar el perfil al correr la app localmente:
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
# o con la variable de entorno SPRING_PROFILES_ACTIVE=dev.

spring.datasource.url=jdbc:mysql://localhost:3306/nutricion_activa?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC
spring.datasource.username=na_app
spring.datasource.password=REEMPLAZAR_CON_TU_CONTRASENA_LOCAL

# Correo saliente (HU-05): opcional para dev local. Sin esto, application.properties
# ya trae spring.mail.username/password vacios por defecto -la app arranca igual,
# el envio real simplemente falla y queda logueado (ver NotificacionCitaListener),
# no rompe nada-. Descomentar y completar solo si necesitas probar el envio real
# de correos contra Gmail en tu maquina.
# spring.mail.username=REEMPLAZAR_CON_TU_CORREO_DE_GMAIL
# spring.mail.password=REEMPLAZAR_CON_TU_CONTRASENA_DE_APLICACION_DE_GMAIL
